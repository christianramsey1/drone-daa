<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- We do not track users across apps or websites -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No tracking domains -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  NSPrivacyAccessedAPITypes is ONLY for Apple's Required Reason APIs:
	  UserDefaults, file timestamps, system boot time, disk space, active keyboards.
	  Location, Bluetooth, and LocalNetwork are NOT Required Reason APIs —
	  they are declared via Info.plist usage description keys.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>

		<!-- UserDefaults: persist app settings and user preferences -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>

	</array>

	<!-- Data collected and how it is used -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>

		<!-- Precise location: map centering and proximity alerts only, not shared -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

	</array>
</dict>
</plist>
